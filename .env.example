# 本文件为仓库根目录共享 .env 模板。
# - 标记为 "系统配置" 的字段由 API/Worker 的 Settings 自动读取，修改后无需改代码。
# - 标记为 "脚本专用" 的字段仅被特定脚本（如 seed_admin.py）读取，不会被 Settings 解析。
# - Settings 使用 extra="ignore"，脚本专用变量不会导致启动报错。
#
# ===== App (系统配置) ====="
APP_ENV=development
APP_DEBUG=true
APP_NAME=Interview Agent Platform
SQL_ECHO=false

# ===== Database =====
DATABASE_URL=postgresql+asyncpg://interview_agent:interview_agent@localhost:5432/interview_agent

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== Milvus =====
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ===== MinIO =====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=interview-agent
MINIO_SECURE=false

# ===== JWT =====
JWT_SECRET_KEY=change_me_to_a_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# ===== LLM Provider =====
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=0

# ===== Embedding Provider =====
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=768

# ===== KB Chunking =====
KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=120
KB_CHUNK_MIN_SIZE=80
KB_EMBEDDING_BATCH_SIZE=20

# ===== RAG Retrieval =====
RAG_RETRIEVAL_TOP_K=3
RAG_CONTEXT_MAX_CHARS=4000
RAG_CITATION_PREVIEW_CHARS=240

# ===== OCR / ASR (reserved) =====
OCR_PROVIDER=
ASR_PROVIDER=

# ===== Experience Search =====
EXPERIENCE_SEARCH_PROVIDER=searxng
SEARXNG_BASE_URL=http://localhost:8080
SEARXNG_TIMEOUT_SECONDS=20
EXPERIENCE_SEARCH_MAX_RESULTS=20
EXPERIENCE_SEARCH_LANGUAGE=zh-CN
EXPERIENCE_SEARCH_SAFESEARCH=0

# ===== Resume =====
RESUME_MAX_FILE_SIZE_MB=10
RESUME_ALLOWED_TYPES=pdf,docx,txt
RESUME_QUESTION_COUNT=8

# ===== Resume KB Retrieval =====
RESUME_KB_RETRIEVAL_ENABLED=true
RESUME_RETRIEVAL_TOP_K=8
RESUME_RETRIEVAL_QUERY_COUNT=5
RESUME_RETRIEVAL_MIN_SCORE=0.55
RESUME_FALLBACK_TO_LLM=true

# ===== Celery =====
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===== Admin Seed (脚本专用) =====
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin
