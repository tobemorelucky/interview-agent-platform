# ===== App =====
APP_ENV=development
APP_DEBUG=true
APP_NAME=Interview Agent Platform

# ===== Database =====
DATABASE_URL=postgresql+asyncpg://interview_agent:interview_agent@localhost:5432/interview_agent

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== Milvus =====
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ===== MinIO =====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=interview-agent
MINIO_SECURE=false

# ===== JWT =====
JWT_SECRET_KEY=change_me_to_a_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# ===== LLM Provider =====
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ===== Embedding Provider =====
EMBEDDING_PROVIDER=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# ===== OCR / ASR (reserved) =====
OCR_PROVIDER=
ASR_PROVIDER=

# ===== Celery =====
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
