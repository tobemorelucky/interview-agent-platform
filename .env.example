# 本文件为仓库根目录共享 .env 模板。
# - 标记为 "系统配置" 的字段由 API/Worker 的 Settings 自动读取，修改后无需改代码。
# - 标记为 "脚本专用" 的字段仅被特定脚本（如 seed_admin.py）读取，不会被 Settings 解析。
# - Settings 使用 extra="ignore"，脚本专用变量不会导致启动报错。
#
# ===== App (系统配置) ====="
APP_ENV=development
# Only development/test permit the local JWT placeholder; other environments fail closed.
APP_DEBUG=true
APP_NAME=Interview Agent Platform
SQL_ECHO=false

# ===== Database (local Compose initialization only; does not rotate existing volumes) =====
POSTGRES_USER=interview_agent
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=interview_agent
DATABASE_URL=postgresql+asyncpg://interview_agent:change-me-db-password@localhost:5432/interview_agent

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== Milvus =====
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ===== MinIO =====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=interview-agent
MINIO_SECURE=false

# ===== JWT =====
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# ===== LLM Provider =====
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro-ga-260813
# Only explicit provider/model availability errors allow fallback; never validation failures.
LLM_FALLBACK_MODEL=doubao-seed-2-1-turbo-260628
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=0

# ===== Embedding Provider =====
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=768

# ===== KB Chunking =====
KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=120
KB_CHUNK_MIN_SIZE=80
KB_EMBEDDING_BATCH_SIZE=20

# ===== RAG Retrieval =====
RAG_RETRIEVAL_TOP_K=3
RAG_CONTEXT_MAX_CHARS=4000
RAG_CITATION_PREVIEW_CHARS=240

# ===== OCR / ASR (reserved) =====
OCR_PROVIDER=
ASR_PROVIDER=

# ===== Experience Search =====
EXPERIENCE_SEARCH_PROVIDER=searxng
SEARXNG_BASE_URL=http://localhost:8080
SEARXNG_TIMEOUT_SECONDS=20
SEARXNG_ENGINES=
EXPERIENCE_SEARCH_MAX_RESULTS=20
EXPERIENCE_SEARCH_LANGUAGE=zh-CN
EXPERIENCE_SEARCH_SAFESEARCH=0
EXPERIENCE_SEARCH_ENABLE_TIME_RANGE=false

# ===== Resume =====
# Private Candidate Profile route (blank endpoint/key/model reuse configured LLM)
RESUME_PROFILE_MODEL=
RESUME_PROFILE_BASE_URL=
RESUME_PROFILE_API_KEY=
RESUME_PROFILE_TIMEOUT_SECONDS=60
RESUME_PROFILE_MAX_OUTPUT_TOKENS=6000
RESUME_PROFILE_PROVIDER_CONCURRENCY=2
RESUME_MAX_FILE_SIZE_MB=10
RESUME_ALLOWED_TYPES=pdf,docx,txt
RESUME_QUESTION_COUNT=8

# ===== Resume KB Retrieval =====
RESUME_KB_RETRIEVAL_ENABLED=true
RESUME_RETRIEVAL_TOP_K=8
RESUME_RETRIEVAL_QUERY_COUNT=5
RESUME_RETRIEVAL_MIN_SCORE=0.55
RESUME_FALLBACK_TO_LLM=true

# ===== M4 Mock Interview =====
# Routes reuse configured LLM when model/endpoint/key are blank.
INTERVIEW_MAIN_MODEL=
ANSWER_EVALUATION_MODEL=
INTERVIEW_MODEL_BASE_URL=
INTERVIEW_MODEL_API_KEY=
INTERVIEW_MODEL_TIMEOUT_SECONDS=60
INTERVIEW_MODEL_MAX_OUTPUT_TOKENS=3000
INTERVIEW_PROVIDER_CONCURRENCY=2
INTERVIEW_MAX_ROUNDS=40
INTERVIEW_MAX_DURATION_SECONDS=7200
INTERVIEW_MAX_MODEL_TOKENS=200000

# ===== M5 Coach / approved memory snapshots =====
# Blank model/endpoint/key reuse configured LLM. Not an automatic Memory writer.
INTERVIEW_COACH_MODEL=
INTERVIEW_COACH_BASE_URL=
INTERVIEW_COACH_API_KEY=
INTERVIEW_COACH_TIMEOUT_SECONDS=60
INTERVIEW_COACH_MAX_OUTPUT_TOKENS=6000
INTERVIEW_COACH_PROVIDER_CONCURRENCY=2
INTERVIEW_COACH_MAX_INPUT_BYTES=200000
# Separate conservative UTF-8-byte budgets (not exact tokenizer counts).
INTERVIEW_APPROVED_MEMORY_LIMIT=8
INTERVIEW_APPROVED_MEMORY_TOKEN_BUDGET=4000
INTERVIEW_OBSERVATION_LIMIT=5
INTERVIEW_OBSERVATION_TOKEN_BUDGET=2000

# ===== M6 Evidence-backed Job Matching =====
# Blank endpoint/key/model reuse configured LLM. No network research fallback.
JOB_MATCHING_MODEL=
JOB_MATCHING_BASE_URL=
JOB_MATCHING_API_KEY=
JOB_MATCHING_TIMEOUT_SECONDS=60
JOB_MATCHING_MAX_OUTPUT_TOKENS=6000
JOB_MATCHING_PROVIDER_CONCURRENCY=2
JOB_MATCHING_MAX_INPUT_BYTES=200000
JOB_MATCHING_TOP_N=20
JOB_MATCHING_RETRIEVAL_LIMIT=200
JOB_MATCHING_PREFERENCE_LIMIT=8
# Conservative UTF-8-byte budget, not an exact tokenizer estimate.
JOB_MATCHING_PREFERENCE_BUDGET=4000

# ===== Celery =====
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===== Admin Seed (脚本专用) =====
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin
